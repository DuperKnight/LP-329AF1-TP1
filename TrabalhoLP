void opção_1 (int original[12])
{   
    int simétrico[12];
    for (int i = 0; i < 12; i++)
    {
        simétrico[i] = -1 * original[i];
    }
    // Ordenar o vetor simétrico por ordem crescente
    for (int i = 0; i < 12 - 1; i++)
    {
        for (int j = 0; j < 12 - i - 1; j++)
        {
            if (simétrico[j] > simétrico[j + 1])
            {
                int aux = simétrico[j];
                simétrico[j] = simétrico[j + 1];
                simétrico[j + 1] = aux;
            }
        }
    }
    printf("Vetor simétrico ordenado: ");
    for (int k = 0; k < 12; k++)
